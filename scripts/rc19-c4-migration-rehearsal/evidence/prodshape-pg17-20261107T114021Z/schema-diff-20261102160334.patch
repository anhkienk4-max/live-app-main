+    ) THEN
+    RAISE EXCEPTION USING ERRCODE = 'P0001', MESSAGE = 'SCHEDULE_SOURCE_REQUIRED_BEFORE_CONFIRM';
+  END IF;
+  RETURN NEW;
+END;
+$$;
+
