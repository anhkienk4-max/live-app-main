# Copy to .env.local for local development.
# NEVER commit real secrets. Supabase anon key + URL are public browser values,
# but must point at the CORRECT project for each environment.
#
# Environment topology:
#   LOCAL    -> local/dev Supabase or mock mode (development only)
#   STAGING  -> separate staging Supabase project + Vercel preview (branch staging)
#   PRODUCTION -> existing production Supabase + Vercel main
#
# DANGER: a wrong NEXT_PUBLIC_SUPABASE_URL points the app at the wrong database.
# Preview deployments MUST use the staging URL, never production.

# --- Supabase (public browser values; env-specific) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Mock mode (local development only; ignored when NODE_ENV=production) ---
NEXT_PUBLIC_USE_MOCK_DATA=true
# Account switcher for mock development only. MUST stay false in production.
NEXT_PUBLIC_ENABLE_MOCK_USER_SWITCHER=true

# --- AI / server-only ---
# OPENAI_API_KEY=
# EMERGENT_LLM_KEY=
# DEFAULT_AI_MODEL=gpt-5.4-mini
# ALLOWED_AI_MODELS=

# --- Vision OCR (server-only) ---
# VISION_OCR_PROVIDER=mock
# VISION_OCR_ENABLED=false
# VISION_OCR_MODEL=
# VISION_OCR_TIMEOUT_MS=30000
# VISION_OCR_RETRY_COUNT=0
# VISION_OCR_DAILY_USER_LIMIT=25
# VISION_OCR_MONTHLY_USER_LIMIT=500
# VISION_OCR_DAILY_GLOBAL_LIMIT=500
# VISION_OCR_ALLOW_TIKTOK=true
# VISION_OCR_ALLOW_SHOPEE=true
# VISION_OCR_ENABLE_MOCK_PROVIDER=true

# --- Feature flags (server-side gating; production default OFF) ---
# FEATURE_IMPORT_BATCH=false
# FEATURE_STAFF_MANAGEMENT_WRITES=false
# FEATURE_ACTUAL_STAFFING=false
# FEATURE_PAYROLL=false
# FEATURE_NOTIFICATIONS=false
# FEATURE_REPORTS_V2=false
# FEATURE_PLATFORM_INGESTION=false

# --- lib/db workspace only (NOT used by the Next.js app runtime) ---
# DATABASE_URL=
