    {"id": "DATA-REGISTRATION", "entity": "ShiftRegistration", "source": "lib/types/database.types.ts", "fields": ["shift_id", "user_id", "operational_role", "status", "source", "imported_name"]},
    {"id": "DATA-IMPORT", "entity": "ScheduleImportBatch/Row", "source": "lib/types/database.types.ts", "fields": ["source", "status", "outcome", "source_row", "shift_id"]},
    {"id": "DATA-REPORT", "entity": "Report", "source": "lib/types/database.types.ts", "fields": ["status", "metrics", "revisions", "images"]},
