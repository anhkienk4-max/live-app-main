  "invariants": [
    {"id": "DATA-INV-001", "expression": "preferred_roles != operational_roles", "source_rule": "BR-001"},
    {"id": "DATA-INV-002", "expression": "confirmed_assignment > imported_staffing_label > unassigned", "source_rule": "BR-005"}
